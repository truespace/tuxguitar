<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<artifactId>tuxguitar-pom</artifactId>
		<groupId>app.tuxguitar</groupId>
		<version>9.99-SNAPSHOT</version>
	</parent>

	<modelVersion>4.0.0</modelVersion>
	<artifactId>tuxguitar-gluon</artifactId>
	<packaging>jar</packaging>
	<name>${project.artifactId}</name>

	<properties>
		<!-- host (macOS/Linux desktop), ios, ios-sim -->
		<gluonfx.target>host</gluonfx.target>
		<gluonfx.version>1.0.29</gluonfx.version>
		<!--
			Must match the JavaFX static SDK linked by Gluon substrate (21-ea+11.3, built from the jfx21 branch):
			mismatched Java classes and native libraries fail at runtime on JNI lookups.
		-->
		<gluon.javafx.version>21.0.3</gluon.javafx.version>
		<!-- iOS bundle identifier: must be covered by an installed provisioning profile -->
		<gluon.app.identifier>com.daengi.tuxguitar</gluon.app.identifier>
		<!-- debug: delay in seconds before TGGluonSnapshot runs on iOS, empty = disabled -->
		<gluon.ios.snapshot></gluon.ios.snapshot>
		<!-- debug: log windows and input events on iOS -->
		<gluon.ios.eventlog>false</gluon.ios.eventlog>
		<!-- src/native (audio output) is compiled for this SDK, see the ios profile -->
		<gluon.native.sdk>macosx</gluon.native.sdk>
		<gluon.native.min.version>-mmacosx-version-min=11.0</gluon.native.min.version>
	</properties>

	<profiles>
		<profile>
			<!-- mvn -Dgluonfx.target=ios ...: bundle share/ into the .app (copied by substrate from src/ios/assets) -->
			<id>ios</id>
			<activation>
				<property>
					<name>gluonfx.target</name>
					<value>ios</value>
				</property>
			</activation>
			<properties>
				<gluon.native.sdk>iphoneos</gluon.native.sdk>
				<gluon.native.min.version>-miphoneos-version-min=12.0</gluon.native.min.version>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>com.gluonhq</groupId>
						<artifactId>gluonfx-maven-plugin</artifactId>
						<configuration>
							<linkerArgs combine.children="append">
								<!-- AVAudioSession, see src/native/tgaudio.m -->
								<list>-framework</list>
								<list>AVFoundation</list>
							</linkerArgs>
							<runtimeArgs>
								<!-- -Dgluon.ios.snapshot=20: window log + BMP snapshots in user.home after 20s (see TGGluonSnapshot) -->
								<list>-Dtuxguitar.gluon.snapshot=${gluon.ios.snapshot}</list>
								<!-- -Dgluon.ios.eventlog=true: log windows/popups and the touch/mouse/action events they receive (see TGGluonEventLog) -->
								<list>-Dtuxguitar.gluon.eventlog=${gluon.ios.eventlog}</list>
							</runtimeArgs>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>1.7</version>
						<executions>
							<execution>
								<id>copy-share-ios</id>
								<phase>package</phase>
								<configuration>
									<target name="copy-share-ios">
										<delete dir="${basedir}/src/ios/assets/share" />
										<copy todir="${basedir}/src/ios/assets/share">
											<fileset dir="${project.build.directory}/share" />
										</copy>
									</target>
								</configuration>
								<goals>
									<goal>run</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-base</artifactId>
				<version>${gluon.javafx.version}</version>
			</dependency>
			<dependency>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-graphics</artifactId>
				<version>${gluon.javafx.version}</version>
			</dependency>
			<dependency>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-controls</artifactId>
				<version>${gluon.javafx.version}</version>
			</dependency>
			<dependency>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-web</artifactId>
				<version>${gluon.javafx.version}</version>
			</dependency>
			<dependency>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-media</artifactId>
				<version>${gluon.javafx.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<sourceDirectory>src</sourceDirectory>
		<resources>
			<!-- default configuration, normally on the class path through the dist/ folder -->
			<resource>
				<directory>../TuxGuitar/dist</directory>
			</resource>
			<!-- default synthesizer programs (every MIDI program mapped to gervill), as in the desktop packages -->
			<resource>
				<directory>../build-scripts/common-resources/common/dist</directory>
			</resource>
			<!-- native-image configuration (reflection, resources, ...), generated by gluonfx:runagent -->
			<resource>
				<directory>src/main/resources</directory>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<!-- share/ folder, read from the file system at runtime (see TGGluonLauncher) -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>1.7</version>
				<executions>
					<execution>
						<id>native-audio</id>
						<phase>compile</phase>
						<configuration>
							<target name="native-audio">
								<mkdir dir="${project.build.directory}/native" />
								<exec executable="xcrun" failonerror="true">
									<arg line="--sdk ${gluon.native.sdk} clang -arch arm64 ${gluon.native.min.version} -O2 -c ${basedir}/src/native/tgaudio.m -o ${project.build.directory}/native/tgaudio.o" />
								</exec>
								<exec executable="xcrun" failonerror="true">
									<arg line="--sdk ${gluon.native.sdk} libtool -static -o ${project.build.directory}/native/libtgaudio.a ${project.build.directory}/native/tgaudio.o" />
								</exec>
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
					<execution>
						<id>copy-share</id>
						<phase>package</phase>
						<configuration>
							<target name="copy-share">
								<copy todir="${project.build.directory}/share">
									<fileset dir="../TuxGuitar/share/" />
								</copy>
								<copy todir="${project.build.directory}/share">
									<fileset dir="../../common/resources/" />
								</copy>
								<copy todir="${project.build.directory}/share/soundfont" overwrite="true">
									<fileset dir="../TuxGuitar-resources/resources/soundfont" />
								</copy>
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- used by gluonfx:runagent to run on the JVM with the native-image tracing agent -->
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>0.0.8</version>
				<configuration>
					<mainClass>app.tuxguitar.gluon.TGGluonLauncher</mainClass>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.gluonhq</groupId>
				<artifactId>gluonfx-maven-plugin</artifactId>
				<version>${gluonfx.version}</version>
				<configuration>
					<target>${gluonfx.target}</target>
					<mainClass>app.tuxguitar.gluon.TGGluonLauncher</mainClass>
					<appIdentifier>${gluon.app.identifier}</appIdentifier>
					<appLabel>TuxGuitar</appLabel>
					<nativeImageArgs>
						<!-- java.util.prefs backend is chosen at image build time (see TGGluonPreferencesFactory) -->
						<list>-Djava.util.prefs.PreferencesFactory=app.tuxguitar.gluon.TGGluonPreferencesFactory</list>
						<list>--initialize-at-build-time=app.tuxguitar.gluon.TGGluonPreferencesFactory</list>
					</nativeImageArgs>
					<!-- synthesizer audio output (TGGluonAudioOutput) -->
					<linkerArgs>
						<list>${project.build.directory}/native/libtgaudio.a</list>
						<list>-framework</list>
						<list>AudioToolbox</list>
					</linkerArgs>
					<verbose>true</verbose>
					<!-- the tracing agent only records what was used in a session: include all translations and settings -->
					<resourcesList>
						<list>META-INF/services/.*</list>
						<list>lang/.*\\.properties</list>
						<list>styles/.*</list>
						<list>[^/]*\\.cfg</list>
						<list>[^/]*\\.dist</list>
						<list>tuxguitar-shortcuts\\.xml</list>
					</resourcesList>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- ImageInfo / ProcessProperties, provided by GraalVM at build and run time -->
		<dependency>
			<groupId>org.graalvm.sdk</groupId>
			<artifactId>nativeimage</artifactId>
			<version>24.1.0</version>
			<scope>provided</scope>
		</dependency>

		<!-- application core -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-lib</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-editor-utils</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-gm-utils</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-ui-toolkit</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-ui-toolkit-jfx</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-awt-graphics</artifactId>
			<scope>compile</scope>
		</dependency>

		<!-- synthesizer: TuxGuitar synth + Gervill, audio through TGGluonAudioOutput -->
		<dependency>
			<groupId>media.sound</groupId>
			<artifactId>gervill</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-synth</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-synth-gervill</artifactId>
			<scope>compile</scope>
		</dependency>

		<!-- plugins: file formats (no AWT / javax.sound dependencies) -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-compat</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-ascii</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-gtp</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-gtp-ui</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-gpx</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-compress</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-ptb</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-tef</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-musicxml</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-midi</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-midi-ui</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-lilypond</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-lilypond-ui</artifactId>
			<scope>compile</scope>
		</dependency>
	</dependencies>
</project>
